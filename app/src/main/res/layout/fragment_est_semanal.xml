                app:layout_gravity="end" />

            <TextView
                android:id="@+id/presupuestoTextView4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/presupuesto"
                android:textAppearance="@style/TextAppearance.AppCompat.Body1"
                app:layout_gravity="end" />

            <TextView
                android:id="@+id/diaTextView5"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/dia5"
                android:textAppearance="@style/TextAppearance.AppCompat.Body1"
                app:layout_gravity="center_vertical"
                app:layout_rowSpan="2" />

            <TextView
                android:id="@+id/gastoTextView5"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/menu_gastos"
                android:textAppearance="@style/TextAppearance.AppCompat.Body1"
                app:layout_gravity="end" />

            <TextView
                android:id="@+id/presupuestoTextView5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/presupuesto"
                android:textAppearance="@style/TextAppearance.AppCompat.Body1"
                app:layout_gravity="end" />

            <TextView
                android:id="@+id/diaTextView6"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/dia6"
                android:textAppearance="@style/TextAppearance.AppCompat.Body1"
                app:layout_gravity="center_vertical"
                app:layout_rowSpan="2" />

            <TextView
                android:id="@+id/gastoTextView6"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/menu_gastos"
                android:textAppearance="@style/TextAppearance.AppCompat.Body1"
                app:layout_gravity="end" />

            <TextView
                android:id="@+id/presupuestoTextView6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/presupuesto"
                android:textAppearance="@style/TextAppearance.AppCompat.Body1"
                app:layout_gravity="end" />

            <TextView
                android:id="@+id/diaTextView7"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/dia7"
                android:textAppearance="@style/TextAppearance.AppCompat.Body1"
                app:layout_gravity="center_vertical"
                app:layout_rowSpan="2" />

            <TextView
                android:id="@+id/gastoTextView7"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/menu_gastos"
                android:textAppearance="@style/TextAppearance.AppCompat.Body1"
                app:layout_gravity="end" />

            <TextView
                android:id="@+id/presupuestoTextView7"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/presupuesto"
                android:textAppearance="@style/TextAppearance.AppCompat.Body1"
                app:layout_gravity="end" />

        </androidx.gridlayout.widget.GridLayout>
