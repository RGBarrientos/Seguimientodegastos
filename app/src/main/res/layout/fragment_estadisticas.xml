<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:columnCount="0"
    android:columnOrderPreserved="false"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingLeft="@dimen/margen"
    android:paddingTop="@dimen/margen"
    android:paddingRight="@dimen/margen"
    android:paddingBottom="@dimen/margen"
    android:useDefaultMargins="true"
    tools:context=".ui.EstadisticasFragment">

    <TextView
        android:id="@+id/tituloTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:text="@string/menu_est"
        android:textAppearance="@style/TextAppearance.AppCompat.Large" />


    <com.github.mikephil.charting.charts.PieChart
        android:id="@+id/graficoPie"
        android:layout_width="match_parent"
        android:layout_height="0dp"

        android:layout_weight="2" />


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/listEstRecyclerV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>