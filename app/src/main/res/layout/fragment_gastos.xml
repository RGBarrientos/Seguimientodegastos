<?xml version="1.0" encoding="utf-8"?>
<GridLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:columnCount="2"
    android:gravity="center"
    android:useDefaultMargins="true"
    android:orientation="vertical"
    tools:context=".ui.GastosFragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:columnCount="2"
            android:gravity="center"
            android:useDefaultMargins="true"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_mi_saldo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_columnSpan="2"
                android:layout_gravity="fill_horizontal"
                android:gravity="center"
                android:text="@string/misaldo"
                android:textAppearance="@style/TextAppearance.AppCompat.Large" />

            <TextView
                android:id="@+id/tv_saldo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_columnSpan="2"
                android:layout_gravity="fill_horizontal"
                android:gravity="center"
                android:text="@string/saldo"
                android:textAppearance="@style/TextAppearance.AppCompat.Large"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_gastos_totales_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="@string/gastos_totales"
                android:textAppearance="@style/TextAppearance.AppCompat.Medium" />

            <TextView
                android:id="@+id/tv_gastos_totales"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_row="2"
                android:layout_gravity="end"
                android:text="@string/gastos_totales_moneda"
                android:textAppearance="@style/TextAppearance.AppCompat.Medium" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="400dp"
                    android:orientation="horizontal">


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Monto"
                            android:textAppearance="@style/TextAppearance.AppCompat.Body1" />

                        <ListView
                            android:id="@+id/list_gastos"
                            android:layout_width="160dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:layout_weight="1" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Categoria"
                            android:textAppearance="@style/TextAppearance.AppCompat.Body1" />
                        <ListView
                            android:id="@+id/list_categoria"
                            android:layout_width="160dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:layout_weight="1" />

                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Descripcion"
                            android:textAppearance="@style/TextAppearance.AppCompat.Body1" />


                        <ListView
                            android:id="@+id/list_descripcion"
                            android:layout_width="160dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:layout_weight="1" />

                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Fechas"
                            android:textAppearance="@style/TextAppearance.AppCompat.Body1" />

                        <ListView
                            android:id="@+id/list_fecha"
                            android:layout_width="160dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:layout_weight="1" />

                    </LinearLayout>


                </LinearLayout>
            </HorizontalScrollView>




            <Button
                android:id="@+id/btn_nuevo_gasto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|fill_horizontal"

                android:layout_marginTop="16dp"
                android:text="@string/btn_nuevo_gasto" />

        </GridLayout>

    </ScrollView>

</GridLayout>