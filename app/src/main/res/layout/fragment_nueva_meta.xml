<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/margen"
    tools:context=".ui.NuevaMetaFragment">

    <TextView
        android:id="@+id/textView23"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/subTituloMetas"
        android:textAppearance="@style/TextAppearance.AppCompat.Body1"
        android:textSize="26sp" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="24dp" />

    <TextView
        android:id="@+id/textView25"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="@string/nueva_meta"
        android:textAppearance="@style/TextAppearance.AppCompat.Large" />

    <androidx.gridlayout.widget.GridLayout
        android:id="@+id/anadirmetaGrid"
        android:layout_width="339dp"
        android:layout_height="192dp"
        android:layout_gravity="center_horizontal"
        android:visibility="visible"
        app:useDefaultMargins="false">

        <TextView
            android:id="@+id/textView14"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nombreNM"
            android:textAppearance="@style/TextAppearance.AppCompat.Large"
            android:textSize="18sp"
            app:layout_column="0"
            app:layout_row="1" />

        <TextView
            android:id="@+id/textView15"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fechaIniNM"
            android:textAppearance="@style/TextAppearance.AppCompat.Large"
            android:textSize="18sp"
            app:layout_column="0"
            app:layout_row="2" />

        <TextView
            android:id="@+id/textView19"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fechaFinNM"
            android:textAppearance="@style/TextAppearance.AppCompat.Large"
            android:textSize="18sp"
            app:layout_column="0"
            app:layout_row="3" />

        <TextView
            android:id="@+id/textView20"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/metaNM"
            android:textAppearance="@style/TextAppearance.AppCompat.Large"
            android:textSize="18sp"
            app:layout_column="0"
            app:layout_row="4" />

        <EditText
            android:id="@+id/nombreMetaEditText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ems="10"
            android:hint="Nombre"
            android:inputType="textPersonName"
            app:layout_column="1"
            app:layout_gravity="right"
            app:layout_row="1" />

        <EditText
            android:id="@+id/inicioMetaEditText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ems="10"
            android:focusable="false"
            android:hint="Inicio"
            android:inputType="date"
            app:layout_column="1"
            app:layout_gravity="right"
            app:layout_row="2" />

        <EditText
            android:id="@+id/finMetaEditText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ems="10"
            android:focusable="false"
            android:hint="Fin"
            android:inputType="date"
            app:layout_column="1"
            app:layout_gravity="right"
            app:layout_row="3" />

        <EditText
            android:id="@+id/objetivoMetaEditText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ems="10"
            android:hint="Objetivo"
            android:inputType="numberDecimal"
            app:layout_column="1"
            app:layout_gravity="right"
            app:layout_row="4" />

    </androidx.gridlayout.widget.GridLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="15dp" />

    <Button
        android:id="@+id/crearMetaButton"
        android:layout_width="144dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="@string/agregar_meta" />
</LinearLayout>