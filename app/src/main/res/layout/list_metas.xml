<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center_horizontal"
    app:cardCornerRadius="4dp"
    app:cardElevation="4dp"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/MargenPeq2"
        android:layout_marginLeft="@dimen/MargenPeq2"
        android:layout_marginTop="@dimen/MargenVertical16"
        android:layout_marginEnd="@dimen/MargenPeq2"
        android:layout_marginRight="@dimen/MargenPeq2"
        android:layout_marginBottom="@dimen/MargenVertical16"
        android:orientation="vertical"
        android:padding="@dimen/MargenPeq">

        <androidx.gridlayout.widget.GridLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            app:columnCount="4"
            app:useDefaultMargins="false">

            <TextView
                android:id="@+id/tituloMetaTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Titulo"
                android:textAppearance="@style/TextAppearance.AppCompat.Large"
                app:layout_columnSpan="4" />

            <TextView
                android:id="@+id/etiInicioMetaTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Inicio:"
                android:textAppearance="@style/TextAppearance.AppCompat.Medium"
                android:textColor="@color/black" />

            <EditText
                android:id="@+id/editTextFechaInicioMeta"
                style="@android:style/Widget.AutoCompleteTextView"
                android:layout_width="123dp"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:ems="10"
                android:focusable="false"
                android:inputType="textPersonName"
                android:text="Name" />

            <TextView
                android:id="@+id/fechaInicioTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fin:"
                android:textAppearance="@style/TextAppearance.AppCompat.Medium"
                android:textColor="@color/black"
                app:layout_column="0"
                app:layout_gravity="end"
                app:layout_row="2" />

            <EditText
                android:id="@+id/editTextFechaFin"
                android:layout_width="123dp"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:ems="10"
                android:focusable="false"
                android:inputType="textPersonName"
                android:text="Name" />

            <TextView
                android:id="@+id/etiMetaMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/MargenPeq"
                android:gravity="center"
                android:text="Meta:"
                android:textAppearance="@style/TextAppearance.AppCompat.Medium"
                android:textColor="@color/black"
                app:layout_gravity="center"
                app:layout_row="1"
                app:layout_rowSpan="3" />

            <TextView
                android:id="@+id/MetaTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="234"
                android:textAppearance="@style/TextAppearance.AppCompat.Medium"
                android:textColor="@color/black"

                app:layout_column="3"
                app:layout_gravity="center|start"
                app:layout_row="1"
                app:layout_rowSpan="3" />

        </androidx.gridlayout.widget.GridLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>